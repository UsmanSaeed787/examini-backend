# Database (PostgreSQL — e.g. Neon serverless)
DATABASE_URL=postgresql://user:password@host/dbname

# Legacy Supabase settings (no longer used; kept for backward compat)
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AI Model Configuration
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gemini-3.6-flash        # any gemini-* routes to Google; other values route to OpenAI

# Cloudinary (file storage for materials — uploads fail without these)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Application
APP_NAME=Examini
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,png,jpg,jpeg
UPLOAD_DIR=uploads

# AI Operating Layer (app/ai — see AI_LAYER_DESIGN.md; all optional, off by default)
# Requires migration 08_create_ai_tables.sql to be run first.
AI_ENABLED=false                      # master switch for /api/ai
AI_USE_AGENTS_FOR_GENERATION=false    # route /api/teachers/exams/generate through the agent
AI_USE_CURRICULUM_ANALYST=false       # assessment workflow: agent-backed curriculum_analysis stage
AI_USE_ASSESSMENT_DESIGNER=false      # assessment workflow: agent-backed assessment_design stage
AI_USE_QUALITY_REVIEWER=false         # assessment workflow: agent-backed quality_review stage
AI_DIFFICULTY_ANALYSIS_MODE=llm       # difficulty_analysis: deterministic (stats only) | llm (adds interpretation)
AI_USE_SCHEDULER=false                # assessment workflow: agent-backed scheduling stage
AI_USE_MATERIALIZATION=true           # turn an approved plan into a draft exam (publishing stays a human action)
# AI_MODEL=gemini-2.5-flash           # override; defaults to OPENAI_MODEL
# AI_MAX_TURNS=8
# AI_RUN_TIMEOUT_SECONDS=180
# AI_MAX_OUTPUT_TOKENS=8192          # ceiling, not a reservation — reasoning
#                                     # models spend this budget thinking, so a
#                                     # low value truncates long structured
#                                     # output mid-JSON (exam_generator
#                                     # overrides this to 16384)
# AI_MAX_RUNS_PER_DAY=50
# AI_MAX_TOKENS_PER_DAY=200000
# AI_MAX_MATERIALS_PER_RUN=5
# AI_TRACING_ENABLED=false
